# ── Database ────────────────────────────────────────────────────────────────
# Local (SQLite): DATABASE_URL="file:./dev.db"  ← also change schema.prisma provider to "sqlite"
# Railway/Production (PostgreSQL): set via Railway dashboard — auto-injected as ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
# Set to your Railway app URL in production (e.g. https://your-app.up.railway.app)
NEXTAUTH_URL="http://localhost:3000"

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user@example.com"
SMTP_PASS="password"
SMTP_FROM="noreply@example.com"
